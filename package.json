{
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "allure-playwright": "^3.11.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3"
  },
  "scripts": {
  "allure:clean": "rimraf allure-results allure-report",
  "allure:generate": "allure generate allure-results --clean -o allure-report",

  "test:ui": "playwright test tests --project=authenticated --project=unauthenticated",
  "test:api": "playwright test --project=api",
  "test:all": "playwright test",

  "test:allure": "run-s -c allure:clean test:ui allure:generate",
  "test:api:allure": "run-s -c allure:clean test:api allure:generate",
  "test:allure:all": "run-s -c allure:clean test:all allure:generate"
},
  "dependencies": {
    "@cucumber/cucumber": "^12.7.0"
  }
}
